{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:song-pages": "node --import tsx scripts/generateSongPages.ts",
    "predev": "npm run generate:song-pages",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run generate:song-pages",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"import('node:fs').then(fs=>['dist','server.js'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})))\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:ux": "node --import tsx .github/scripts/song-page-layout.mjs --ux-only",
    "test:browser": "node --import tsx .github/scripts/song-page-layout.mjs",
    "check": "npm run lint && npm test && npm run build && npm audit --audit-level=low"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "playwright": "1.60.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
